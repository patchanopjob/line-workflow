<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- KPI cards -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
  <div class="card p-4">
    <div class="text-xs text-slate-500">ข้อความที่เก็บได้ทั้งหมด</div>
    <div class="text-2xl font-bold mt-1"><%= formatNumber(overview.totalMessages) %></div>
    <div class="text-[11px] text-slate-400 mt-1">
      เริ่มเก็บ <%= formatDate(overview.firstMessageAt) %>
    </div>
  </div>
  <div class="card p-4">
    <div class="text-xs text-slate-500">ข้อความวันนี้</div>
    <div class="text-2xl font-bold mt-1 text-line"><%= formatNumber(overview.todayMessages) %></div>
    <div class="text-[11px] text-slate-400 mt-1">ล่าสุด <%= formatDateTime(overview.lastMessageAt) %></div>
  </div>
  <div class="card p-4">
    <div class="text-xs text-slate-500">กลุ่มที่บอทอยู่</div>
    <div class="text-2xl font-bold mt-1"><%= formatNumber(overview.activeGroups) %></div>
    <div class="text-[11px] text-slate-400 mt-1">กลุ่มที่ยัง active</div>
  </div>
  <div class="card p-4">
    <div class="text-xs text-slate-500">งานค้างติดตาม</div>
    <div class="text-2xl font-bold mt-1 text-amber-600"><%= formatNumber(overview.openTasks) %></div>
    <div class="text-[11px] text-slate-400 mt-1">สถานะ open</div>
  </div>
  <div class="card p-4">
    <div class="text-xs text-slate-500">โควต้าข้อความคงเหลือ</div>
    <div class="text-2xl font-bold mt-1">
      <% if (quota.limit === null) { %>-<% } else { %><%= formatNumber(quota.limit - (quota.used || 0)) %><% } %>
    </div>
    <div class="text-[11px] text-slate-400 mt-1">
      <% if (quota.mock) { %>ค่าจำลอง (โหมด MOCK)<% } else { %>ใช้ไป <%= formatNumber(quota.used) %> / <%= formatNumber(quota.limit) %><% } %>
    </div>
  </div>
</div>

<!-- charts -->
<div class="grid lg:grid-cols-3 gap-4">
  <div class="card p-5 lg:col-span-2">
    <div class="text-sm font-semibold mb-3">จำนวนข้อความรายวัน (14 วันย้อนหลัง)</div>
    <canvas id="chartDaily" height="110"></canvas>
  </div>
  <div class="card p-5">
    <div class="text-sm font-semibold mb-3">สัดส่วนชนิดข้อความ</div>
    <canvas id="chartTypes" height="180"></canvas>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-4">
  <div class="card p-5 lg:col-span-2">
    <div class="text-sm font-semibold mb-3">ความคึกคักตามช่วงเวลา (30 วัน)</div>
    <canvas id="chartHourly" height="110"></canvas>
  </div>
  <div class="card p-5">
    <div class="text-sm font-semibold mb-3">คนที่คุยมากที่สุด</div>
    <% if (talkers.length === 0) { %>
      <p class="text-sm text-slate-400">ยังไม่มีข้อมูล</p>
    <% } else { %>
      <div class="space-y-3">
        <% const maxTalk = talkers[0].count %>
        <% talkers.forEach(function (t, i) { %>
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="font-medium"><%= i + 1 %>. <%= t.name %></span>
              <span class="text-slate-500"><%= formatNumber(t.count) %></span>
            </div>
            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-line" style="width: <%= Math.round((t.count / maxTalk) * 100) %>%"></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- tasks + logs -->
<div class="grid lg:grid-cols-2 gap-4">
  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <div class="text-sm font-semibold">งานค้างล่าสุด</div>
      <a href="/tasks<%= selectedGroup ? '?group=' + encodeURIComponent(selectedGroup) : '' %>" class="text-xs text-line font-medium">ดูทั้งหมด</a>
    </div>
    <% if (openTasks.length === 0) { %>
      <p class="text-sm text-slate-400">ไม่มีงานค้าง ลองสั่ง AI สรุปบทสนทนาเพื่อสกัดงานออกมา</p>
    <% } else { %>
      <ul class="space-y-2">
        <% openTasks.forEach(function (t) { %>
          <li class="text-sm flex gap-2">
            <span class="text-line">•</span>
            <span>
              <span class="font-medium"><%= t.assignee || 'ไม่ระบุ' %></span>:
              <%= t.task_text %>
              <% if (t.due_text) { %><span class="text-amber-600 text-xs">(<%= t.due_text %>)</span><% } %>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <div class="text-sm font-semibold">การส่งข้อความล่าสุด</div>
      <a href="/logs" class="text-xs text-line font-medium">ดูทั้งหมด</a>
    </div>
    <% if (recentLogs.length === 0) { %>
      <p class="text-sm text-slate-400">ยังไม่มีการส่งข้อความออกจากระบบ</p>
    <% } else { %>
      <div class="overflow-x-auto -mx-2">
        <table class="w-full">
          <tbody>
            <% recentLogs.forEach(function (l) { %>
              <tr>
                <td class="text-xs text-slate-500 whitespace-nowrap"><%= formatDateTime(l.created_at) %></td>
                <td class="text-xs"><%= l.target_name || l.target_id || l.target_type %></td>
                <td class="text-xs truncate max-w-[200px]"><%= l.preview %></td>
                <td>
                  <span class="badge <%= l.status === 'sent' ? 'bg-emerald-100 text-emerald-700' : l.status === 'failed' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600' %>"><%= l.status %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  const daily = <%- JSON.stringify(daily) %>
  const hourly = <%- JSON.stringify(hourly) %>
  const types = <%- JSON.stringify(types) %>

  new Chart(document.getElementById('chartDaily'), {
    type: 'line',
    data: {
      labels: daily.map(d => d.day.slice(5)),
      datasets: [{
        label: 'ข้อความ',
        data: daily.map(d => d.count),
        borderColor: '#06C755',
        backgroundColor: 'rgba(6,199,85,0.12)',
        fill: true,
        tension: 0.35,
        pointRadius: 3
      }]
    },
    options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
  })

  new Chart(document.getElementById('chartHourly'), {
    type: 'bar',
    data: {
      labels: hourly.map((_, i) => i + ':00'),
      datasets: [{ label: 'ข้อความ', data: hourly, backgroundColor: '#0C1628' }]
    },
    options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
  })

  if (types.length > 0) {
    new Chart(document.getElementById('chartTypes'), {
      type: 'doughnut',
      data: {
        labels: types.map(t => t.type),
        datasets: [{ data: types.map(t => t.count), backgroundColor: ['#06C755', '#0C1628', '#D97706', '#C8281E', '#5072B8', '#8A94A6'] }]
      },
      options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } } }
    })
  }
</script>

<%- include('partials/foot') %>
