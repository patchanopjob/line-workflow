# ==========================================================================
# Day 1: ต้องการแค่ค่าของ LINE เท่านั้น (ยังไม่มีฐานข้อมูลในวันแรก)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#   Windows : copy .env.example .env
#   mac/Linux: cp .env.example .env
# ==========================================================================

# ---------- 1) LINE Messaging API ----------
# Developers Console > tab Messaging API > Channel access token (long-lived)
CHANNEL_ACCESS_TOKEN=

# Developers Console > tab Basic settings (คนละที่กับ token ด้านบน)
# ใช้ตรวจ signature ของ webhook ถ้าไม่ใส่ ระบบจะข้ามการตรวจและเตือนใน log
CHANNEL_SECRET=

# true = ไม่ยิง LINE API จริง แค่พิมพ์ลง console (ทดสอบได้โดยยังไม่มี OA)
# ถ้าไม่ได้ใส่ CHANNEL_ACCESS_TOKEN ระบบจะบังคับเป็น true ให้เอง
MOCK_LINE=true

# ---------- 2) เซิร์ฟเวอร์ ----------
PORT=3000
TZ=Asia/Bangkok
NODE_ENV=development
