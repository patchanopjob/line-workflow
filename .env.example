# ==========================================================
#  LINE Workflow Automation Workshop 2026 - ตัวอย่างไฟล์ config
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#  Windows:  copy .env.example .env
#  mac/Linux: cp .env.example .env
# ==========================================================

# ---------- 1) ฐานข้อมูล PostgreSQL ----------
# ในเครื่อง: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linechat

# ถ้าใช้ฐานข้อมูลบน cloud (Neon / Supabase / Render) ให้ใส่ ?sslmode=require ต่อท้าย
# ระบบจะเปิด SSL ให้อัตโนมัติเมื่อเจอ sslmode ใน URL
# ตัวอย่าง Neon (ใช้ connection string แบบ pooled ที่มีคำว่า -pooler):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/linechat?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_NO_VERIFY=false

# จำนวน connection สูงสุดใน pool (ปกติไม่ต้องแก้)
PG_POOL_MAX=10

# ---------- 2) เซิร์ฟเวอร์ ----------
PORT=3000
TZ=Asia/Bangkok
# development เมื่อรันในเครื่อง / production เมื่อ deploy จริง
NODE_ENV=development

# ---------- 3) LINE Messaging API ----------
# ได้จาก LINE Developers Console > Channel ของคุณ
# Basic settings   -> Channel secret
# Messaging API    -> Channel access token (long-lived)
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# โหมดจำลอง: true = ไม่ยิง API จริง แค่บันทึก log (ใช้ทดสอบ dashboard ก่อนมี LINE OA)
# ตั้งเป็น false เมื่อพร้อมส่งเข้า LINE จริง
MOCK_LINE=true

# groupId ปลายทางเริ่มต้น (ขึ้นต้นด้วย C...) ปล่อยว่างได้ ระบบจะเลือกจาก dropdown ให้
# สคริปต์และตัวตั้งเวลาจะใช้ค่านี้เมื่อไม่ได้ระบุ --group
# ตอนซ้อมด้วยข้อมูลจำลอง (npm run seed:chat) ใส่กลุ่มผู้บริหารจำลองได้เลย:
#   DEFAULT_GROUP_ID=Cdemo000000000000000000000000002
DEFAULT_GROUP_ID=

# ---------- 4) Admin Dashboard ----------
ADMIN_USERNAME=admin
# ใช้รหัสผ่านแบบข้อความธรรมดา (สะดวกตอนเรียน) หรือทำ hash ด้วย npm run hash-password
ADMIN_PASSWORD=admin1234
ADMIN_PASSWORD_HASH=
# ตอน deploy จริงให้เปลี่ยนเป็นข้อความสุ่มยาว ๆ (เช่น openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-long-random-string

# เก็บ session ลง PostgreSQL (ค่าเริ่มต้น: เปิดเมื่อ NODE_ENV=production)
# ถ้าไม่เปิด ล็อกอินจะหลุดทุกครั้งที่เซิร์ฟเวอร์ restart
# SESSION_IN_DATABASE=true

# อยู่หลัง reverse proxy เช่น Render / Nginx / Cloudflare (ค่าเริ่มต้น: เปิดเมื่อ production)
# TRUST_PROXY=true

# ส่ง cookie เฉพาะผ่าน HTTPS (ค่าเริ่มต้น: เปิดเมื่อ production)
# ถ้าต้องรัน production ผ่าน http ล้วน ให้ตั้งเป็น false ไม่งั้นจะล็อกอินไม่ได้
# COOKIE_SECURE=true

# ---------- 5) AI สรุปบทสนทนา (ไม่ใส่ก็ได้) ----------
# ถ้าไม่ใส่ ระบบจะใช้ตัวสรุปแบบ rule-based ในเครื่องแทน (ทำงานได้ แต่ไม่ฉลาดเท่า)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- 6) Capstone: เกณฑ์แจ้งเตือนรายการผิดปกติ ----------
ANOMALY_AMOUNT_THRESHOLD=300000

# ---------- 7) เก็บไฟล์จากไลน์กลุ่มถาวร (Workshop 6) ----------
# LINE ระบุว่าไฟล์ที่ผู้ใช้ส่งจะถูกลบอัตโนมัติหลังผ่านไประยะหนึ่ง (ไม่บอกว่ากี่วัน)
# ระบบจึงดาวน์โหลดมาเก็บไว้เองทันทีที่ webhook เข้ามา
MEDIA_ARCHIVE_ENABLED=true

# local = เก็บลงดิสก์ในเครื่อง (ใช้ตอนเรียน) | s3 = เก็บขึ้น object storage (ใช้ตอน deploy จริง)
#
# ★ ขึ้น production ต้องเป็น s3 เท่านั้น ★
#   ดิสก์ของ Render เป็นแบบ ephemeral ไฟล์จะหายทุกครั้งที่ deploy ใหม่
#   ขั้นตอนเต็มอยู่ใน Docs/10-Deployment-Render-Neon.md ขั้นที่ 7
#   เปลี่ยนค่าบรรทัดล่างเป็น s3 แล้วกรอก S3_* ให้ครบ จากนั้นตรวจด้วย npm run storage:check
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=storage/media

# ไม่โหลดไฟล์ที่ใหญ่เกินนี้ (MB) กันดิสก์เต็มโดยไม่ตั้งใจ
MEDIA_MAX_SIZE_MB=25
# ชนิดที่จะเก็บ: image, video, audio, file
MEDIA_TYPES=image,video,audio,file
# เก็บภาพย่อไว้แสดงในแกลเลอรีด้วย (ประหยัดแบนด์วิดท์)
MEDIA_SAVE_PREVIEW=true

# ---- Object storage: Cloudflare R2 / AWS S3 / MinIO ----
# ใช้เมื่อ MEDIA_STORAGE_DRIVER=s3 เท่านั้น (@aws-sdk/client-s3 อยู่ใน dependencies แล้ว)
#
# ค่าทั้งหมดได้จาก Cloudflare Dashboard > R2 Object Storage
#   S3_BUCKET             ชื่อ bucket ที่สร้างไว้
#   S3_REGION             R2 ใช้ 'auto' เสมอ (AWS S3 จริงใส่ชื่อ region เช่น ap-southeast-1)
#   S3_ENDPOINT           API > Manage API tokens จะแสดงให้ ใส่แค่ส่วนโดเมน
#                         ★ ห้ามมีชื่อ bucket ต่อท้าย ไม่งั้นจะขึ้น NoSuchBucket ★
#                         ถ้าใช้ AWS S3 จริงให้เว้นว่างไว้
#   S3_ACCESS_KEY_ID      จาก R2 API token แบบ Object Read & Write (ผูก bucket เดียว)
#   S3_SECRET_ACCESS_KEY  ดูได้ครั้งเดียวตอนสร้าง token เก็บให้ดี
S3_BUCKET=line-workflow-media
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- 8) ตัวตั้งเวลาในตัวโปรแกรม ----------
# ใช้แทน Windows Task Scheduler เมื่อ deploy บน cloud ที่รันค้างตลอด (เช่น Render Starter)
# ในคลาส/ในเครื่องตัวเอง ให้ปิดไว้ (false) แล้วใช้ Task Scheduler ตาม Workshop 5
ENABLE_SCHEDULER=false
# รูปแบบ cron 5 ช่อง: นาที ชั่วโมง วันที่ เดือน วันในสัปดาห์ (เวลาตาม TZ ด้านบน)
SUMMARY_CRON=0 18 * * *
REPORT_CRON=0 8 * * *
